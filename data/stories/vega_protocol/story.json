{
  "id": "vega_protocol",
  "nameKey": "story.vega_protocol.name",
  // #2470: VEGA as its own pack (synthesis §4.6/§4.7, §5.4). The prologue is the cold open of the game; the story track
  // (story:vega_protocol:started) starts after the basic training — or at once when the tutorial is off, for a veteran,
  // on "Start the story now", or in the finale system. Until then the world's beats are held for that player and arrive
  // as one recap at the start. Chapters follow the beats; a player's chapter is derived (max(1, world)), never stored.
  // Every behaviour-relevant field here is mirrored in StoryRegistry.BuildVegaProtocol (no-drift test).
  "kind": "story",
  "scope": "world",
  "shortNameKey": "story.vega.short",
  "descriptionKey": "story.vega.desc", // #2472: the one line under the main story on the world-creation Stories page
  "narrator": {
    "id": "vega", "nameKey": "ui.vega.name", "icon": "icon_vega", "color": "#5FD8FF",
    "voice": [ "vega_chatter_1", "vega_chatter_2", "vega_chatter_3" ], "lineStart": "ai_blip"
  },
  // #2478: the pack's other voice — the Guardian core in the duel dialogue (red, the anomaly's hum when it speaks).
  // #3899: ECHO, VEGA's sister core of the escort wing — the voice of the scene echo.speaks (blue, like the lamps she is
  // freed under; the engine's name key chr.echo.name, which the bridge code uses for her panel lines too).
  "speakers": [
    { "id": "core", "nameKey": "ui.finale.duel_title", "color": "#FF5A4A", "lineStart": "anomaly_hum" },
    { "id": "echo", "nameKey": "chr.echo.name", "color": "#6FA8FF", "lineStart": "ai_blip" }
  ],
  "introCutscene": "prologue",
  // #2478: the finale set pieces (cutscenes.json), each played once per player whose story track started: the arrival card
  // when the flight enters the Guardian system, the descent when landing on the core world (it shows the guardian_core hint),
  // the breach when the hack completes (on the core world; elsewhere the duel banner), the stand-down when the duel is won
  // (owed to whoever missed it) and the ending on the director (an older client gets StoryResolved instead).
  "finale": {
    "type": "guardian_core",
    "cutscenes": {
      "arrival": "fin.arrival", "descent": "fin.descent", "breach": "fin.breach", "duel": "fin.duel",
      "standdown": "fin.standdown", "resolution": "resolution"
    }
  },
  "start": { "after": [ "chapter:tutorial:b6" ], "earlyOptIn": true },
  "chapters": [
    // #2474: every chapter of the arc opens with its scene (cutscenes.json): at the beat that starts it, and once for the
    // player's current chapter at their story-track start. The resolution's scene is the finale's (finale.cutscenes).
    // #2475: the chapter leads (synthesis §4.7/§4.8, option O2) — the compass on VEGA's chip and the Journal's tasks; the
    // score stays the clock (a lead never holds a beat back). Per player: the first open lead that is feasible here; when none
    // is, a fragment on this world, then a settlement job, then "explore". The first lead anyone follows in a chapter pays
    // leadBonusMilestones once per save (before B12 only).
    // #2476: the story missions (synthesis §4.8 option O3) — VEGA hands a chapter's mission to each player whose track is in
    // that chapter (after the chapter's scene; never during the basic training), one at a time; it takes the lead's place on
    // the chip while it runs and is let go when the player's chapter moves on. A mission never holds a beat back. "Lead" steps
    // are followed exactly like that chapter lead (and show its placed text); a mission or step this world cannot offer is
    // skipped and its alternative stands in. Finishing one counts as following a lead for the chapter bonus (once per save and
    // chapter). Chapter 7 has none: the finale is its mission. Not mirrored in BuildVegaProtocol (its texts live in this pack).
    { "id": "awakening",    "titleKey": "story.vega.ch.awakening",    "fromBeat": 0, "openCutscene": "prologue" },
    { "id": "signature",    "titleKey": "story.vega.ch.signature",    "fromBeat": 1, "openCutscene": "ch1.open",
      "leads": [ { "type": "fragment" } ],
      "missions": [
        { "id": "m_signal", "titleKey": "story.vega.m.signal.title", "steps": [
          { "id": "m_signal.1", "tier": "core", "objective": { "type": "Lead", "target": "fragment" },
            "feasibleIf": [ "world:fragments_left" ], "alternative": "m_signal.1a",
            "explain": { "startKey": "story.vega.m.signal.1.start", "chipKey": "story.vega.m.signal.1.obj",
                         "hintKey": "story.vega.m.hint.fragment", "doneKey": "story.vega.m.signal.1.done" } },
          { "id": "m_signal.1a", "tier": "core", "objective": { "type": "Lead", "target": "settlement_help" },
            "feasibleIf": [ "world:settlements" ],
            "explain": { "startKey": "story.vega.m.signal.1a.start", "chipKey": "story.vega.obj.settlement_help",
                         "hintKey": "story.vega.m.hint.settlement", "doneKey": "story.vega.m.signal.1a.done" } } ] } ] },
    { "id": "service",      "titleKey": "story.vega.ch.service",      "fromBeat": 2, "openCutscene": "ch2.open",
      "leads": [ { "type": "unique_site:observatory" }, { "type": "fragment" } ],
      "missions": [
        { "id": "m_observatory", "titleKey": "story.vega.m.observatory.title",
          "feasibleIf": [ "world:observatory_reachable" ], "alternative": "m_archive", "steps": [
          { "id": "m_observatory.1", "tier": "core", "objective": { "type": "Lead", "target": "unique_site:observatory" },
            "explain": { "startKey": "story.vega.m.observatory.1.start", "chipKey": "story.vega.m.observatory.1.obj",
                         "hintKey": "story.vega.m.observatory.1.hint" } },
          { "id": "m_observatory.2", "tier": "core", "objective": { "event": "lore:read", "arg": "observatory" },
            "alreadyDoneIf": [ "lore:observatory_log" ],
            "onStart": { "reveal": "unique_site:observatory" }, "escalate": { "markerAfter": 5 },
            "explain": { "startKey": "story.vega.m.observatory.2.start", "chipKey": "story.vega.m.observatory.2.obj",
                         "hintKey": "story.vega.m.observatory.2.hint", "doneKey": "story.vega.m.observatory.2.done" } } ] },
        { "id": "m_archive", "titleKey": "story.vega.m.archive.title", "feasibleIf": [ "world:vaults" ], "steps": [
          { "id": "m_archive.1", "tier": "core", "objective": { "event": "lore:read", "arg": "vault" },
            "alreadyDoneIf": [ "lore:vault_plaque" ],
            "explain": { "startKey": "story.vega.m.archive.1.start", "chipKey": "story.vega.m.archive.1.obj",
                         "hintKey": "story.vega.m.archive.1.hint", "doneKey": "story.vega.m.archive.1.done" } } ] },
        // #3899: the sky-lights (canon C19) — after the observatory (or its stand-in): reach a guide tower, read its relay
        // console. It stays open after the chapter ("keep": a tower may be worlds away) and is skipped silently in a save
        // that can have no towers (terrain generation below 47, or switched off) — no stand-in, like nothing was there.
        // While no tower is known yet VEGA says where the first one will be (the variant); the marker names a visited world
        // with a tower from afar. A tower found or read before the mission counts. Chapter 2 knows the Service and nothing
        // of the Guardian: the texts say nothing of why the lamps are red (VEGA's own tower lines follow the player's story).
        { "id": "m_sky_light", "titleKey": "story.vega.m.sky_light.title", "keep": true,
          "feasibleIf": [ "world:sps_towers" ], "steps": [
          { "id": "m_sky_light.1", "tier": "core", "objective": { "event": "sps_tower:found" },
            "alreadyDoneIf": [ "world:sps_tower_near" ],
            "onStart": { "reveal": "nearest_sps_tower" }, "escalate": { "markerAfter": 5 },
            "variants": [ { "when": "not:world:sps_tower_known", "startKey": "story.vega.m.sky_light.1.start_unknown",
                            "hintKey": "story.vega.m.sky_light.1.hint_unknown" } ],
            "explain": { "startKey": "story.vega.m.sky_light.1.start", "chipKey": "story.vega.m.sky_light.1.obj",
                         "hintKey": "story.vega.m.sky_light.1.hint", "doneKey": "story.vega.m.sky_light.1.done" } },
          { "id": "m_sky_light.2", "tier": "core", "objective": { "event": "lore:read", "arg": "sps_tower" },
            "alreadyDoneIf": [ "any:[lore:tower_ships,lore:tower_echo_1]" ],
            "onStart": { "reveal": "nearest_sps_tower" }, "escalate": { "markerAfter": 5 },
            "explain": { "startKey": "story.vega.m.sky_light.2.start", "chipKey": "story.vega.m.sky_light.2.obj",
                         "hintKey": "story.vega.m.sky_light.2.hint", "doneKey": "story.vega.m.sky_light.2.done" } } ] } ] },
    { "id": "guardian",     "titleKey": "story.vega.ch.guardian",     "fromBeat": 5, "openCutscene": "ch3.open",
      "leads": [ { "type": "monument" }, { "type": "settlement_help" } ],
      "missions": [
        { "id": "m_runes", "titleKey": "story.vega.m.runes.title", "steps": [
          { "id": "m_runes.1", "tier": "core", "objective": { "type": "Lead", "target": "monument" },
            "explain": { "startKey": "story.vega.m.runes.1.start", "chipKey": "story.vega.m.runes.1.obj",
                         "hintKey": "story.vega.m.runes.1.hint" } },
          { "id": "m_runes.2", "tier": "core", "objective": { "type": "Lead", "target": "settlement_help" },
            "feasibleIf": [ "world:settlements" ],
            "explain": { "startKey": "story.vega.m.runes.2.start", "chipKey": "story.vega.obj.settlement_help",
                         "hintKey": "story.vega.m.hint.settlement", "doneKey": "story.vega.m.runes.2.done" } } ] } ] },
    { "id": "verdict",      "titleKey": "story.vega.ch.verdict",      "fromBeat": 6, "openCutscene": "ch4.open",
      "leads": [ { "type": "unique_site:derelict" }, { "type": "heal_tank" } ],
      "missions": [
        { "id": "m_long_quiet", "titleKey": "story.vega.m.long_quiet.title",
          "feasibleIf": [ "world:derelict_reachable" ], "alternative": "m_wrecks", "steps": [
          { "id": "m_long_quiet.1", "tier": "core", "objective": { "type": "Lead", "target": "unique_site:derelict" },
            "explain": { "startKey": "story.vega.m.long_quiet.1.start", "chipKey": "story.vega.m.long_quiet.1.obj",
                         "hintKey": "story.vega.m.long_quiet.1.hint" } },
          { "id": "m_long_quiet.2", "tier": "core", "objective": { "event": "lore:read", "arg": "derelict" },
            "alreadyDoneIf": [ "lore:derelict_manifest" ],
            "explain": { "startKey": "story.vega.m.long_quiet.2.start", "chipKey": "story.vega.m.long_quiet.2.obj",
                         "hintKey": "story.vega.m.long_quiet.2.hint", "doneKey": "story.vega.m.long_quiet.2.done" } } ] },
        { "id": "m_wrecks", "titleKey": "story.vega.m.wrecks.title",
          "feasibleIf": [ "world:free_flight", "world:space_wrecks" ], "steps": [
          { "id": "m_wrecks.1", "tier": "core", "objective": { "event": "scan:any", "arg": "wreck" },
            "explain": { "startKey": "story.vega.m.wrecks.1.start", "chipKey": "story.vega.m.wrecks.1.obj",
                         "hintKey": "story.vega.m.wrecks.1.hint", "doneKey": "story.vega.m.wrecks.1.done" } } ] },
        // #3685: the guardian giants (canon C18) — find a lying giant, scan it, and VEGA remembers the Service's builders (the
        // beat card giant.remembers; its line is the insight guardian_giant, kept in the Journal's VEGA notes). It comes after
        // The Long Quiet (one mission at a time, in this order), never in its place. A world without giants (terrain generation
        // below 44) gets the stand-in: scan an old wreck, or stop a Guardian machine — and the same memory at its end.
        { "id": "m_fallen_giant", "titleKey": "story.vega.m.fallen_giant.title",
          "feasibleIf": [ "world:guardian_giants" ], "alternative": "m_giant_echo", "steps": [
          { "id": "m_fallen_giant.1", "tier": "core", "objective": { "event": "guardian_giant:found" },
            "alreadyDoneIf": [ "world:guardian_giant_near" ],
            "explain": { "startKey": "story.vega.m.fallen_giant.1.start", "chipKey": "story.vega.m.fallen_giant.1.obj",
                         "hintKey": "story.vega.m.fallen_giant.1.hint", "doneKey": "story.vega.m.fallen_giant.1.done" } },
          { "id": "m_fallen_giant.2", "tier": "core", "objective": { "event": "scan:performed", "arg": "guardian_giant" },
            "onComplete": { "cutscene": "giant.remembers" },
            "explain": { "startKey": "story.vega.m.fallen_giant.2.start", "chipKey": "story.vega.m.fallen_giant.2.obj",
                         "hintKey": "story.vega.m.fallen_giant.2.hint", "doneKey": "story.vega.m.fallen_giant.2.done" } } ] },
        { "id": "m_giant_echo", "titleKey": "story.vega.m.giant_echo.title", "steps": [
          { "id": "m_giant_echo.1", "tier": "core", "objective": { "event": "scan:performed", "arg": "wreck|giant_wreck" },
            "feasibleIf": [ "world:free_flight", "world:space_wrecks" ], "alternative": "m_giant_echo.1a",
            "onComplete": { "cutscene": "giant.remembers" },
            "explain": { "startKey": "story.vega.m.giant_echo.1.start", "chipKey": "story.vega.m.giant_echo.1.obj",
                         "hintKey": "story.vega.m.giant_echo.1.hint", "doneKey": "story.vega.m.giant_echo.1.done" } },
          { "id": "m_giant_echo.1a", "tier": "core", "objective": { "type": "Lead", "target": "machines" },
            "feasibleIf": [ "world:enemies" ],
            "onComplete": { "cutscene": "giant.remembers" },
            "explain": { "startKey": "story.vega.m.giant_echo.1a.start", "chipKey": "story.vega.m.giant_echo.1a.obj",
                         "hintKey": "story.vega.m.giant_echo.1a.hint", "doneKey": "story.vega.m.giant_echo.1a.done" } } ] } ] },
    { "id": "what_you_are", "titleKey": "story.vega.ch.what_you_are", "fromBeat": 9, "openCutscene": "ch5.open",
      "leads": [ { "type": "research:radar_array" }, { "type": "settlement_help" } ],
      "missions": [
        { "id": "m_radar", "titleKey": "story.vega.m.radar.title", "steps": [
          { "id": "m_radar.1", "tier": "core", "objective": { "type": "Lead", "target": "research:radar_array" },
            "explain": { "startKey": "story.vega.m.radar.1.start", "chipKey": "story.vega.m.radar.1.obj",
                         "hintKey": "story.vega.m.hint.research" } },
          { "id": "m_radar.2", "tier": "core", "objective": { "type": "Lead", "target": "module:radar_array" },
            "explain": { "startKey": "story.vega.m.radar.2.start", "chipKey": "story.vega.m.radar.2.obj",
                         "hintKey": "story.vega.m.hint.module", "doneKey": "story.vega.m.radar.2.done" } } ] },
        // #3899: the sleeper (canon C20, C21) — after the radar: build a hacking chip, light a guide tower, open the capsule
        // tank of a guard post, talk to the guard. Kept; skipped silently without towers. Each step counts what was done
        // before (a chip carried, a tower lit by this player or lit nearby, a tank opened in this save, the dialog talked
        // through) — and the story glue (GameServerSkyLightMissions.cs) books the same evidence when it turns true while
        // the step runs (a chip dropped by a Hunter, a tank somebody else opened). Step 3 has ONE objective whatever the
        // world knows; its variant only changes the words while no guard post is known (about four towers in ten have one,
        // the save's first tower always) — a stand-in step could never hand back, and a wait would leave the chip empty.
        // The chapter starts with B9, so VEGA may speak of the heal tank as the player's cradle; "He is like you" is the
        // insight sps_guard, said near the guard after the talk.
        { "id": "m_sleeper", "titleKey": "story.vega.m.sleeper.title", "keep": true,
          "feasibleIf": [ "world:sps_towers" ], "steps": [
          { "id": "m_sleeper.1", "tier": "core", "objective": { "event": "craft:any", "arg": "hacking_chip" },
            "alreadyDoneIf": [ "any:[world:hacking_chip_carried,world:sps_guard_awake]" ],
            "explain": { "startKey": "story.vega.m.sleeper.1.start", "chipKey": "story.vega.m.sleeper.1.obj",
                         "hintKey": "story.vega.m.sleeper.1.hint", "doneKey": "story.vega.m.sleeper.1.done" } },
          { "id": "m_sleeper.2", "tier": "core", "objective": { "event": "sps_tower:lit" },
            "alreadyDoneIf": [ "any:[world:sps_tower_lit_near,world:sps_tower_lit_by_player]" ],
            "onStart": { "reveal": "nearest_sps_tower" }, "escalate": { "markerAfter": 5 },
            "explain": { "startKey": "story.vega.m.sleeper.2.start", "chipKey": "story.vega.m.sleeper.2.obj",
                         "hintKey": "story.vega.m.sleeper.2.hint", "doneKey": "story.vega.m.sleeper.2.done" } },
          { "id": "m_sleeper.3", "tier": "core", "objective": { "event": "capsule:opened" },
            "alreadyDoneIf": [ "world:sps_guard_awake" ],
            "onStart": { "reveal": "nearest_sps_guard" }, "escalate": { "markerAfter": 5 },
            "variants": [ { "when": "not:world:sps_guard_post_known", "startKey": "story.vega.m.sleeper.3.start_unknown",
                            "chipKey": "story.vega.m.sleeper.3.obj_unknown", "hintKey": "story.vega.m.sleeper.3.hint_unknown" } ],
            "explain": { "startKey": "story.vega.m.sleeper.3.start", "chipKey": "story.vega.m.sleeper.3.obj",
                         "hintKey": "story.vega.m.sleeper.3.hint" } },
          { "id": "m_sleeper.4", "tier": "core", "objective": { "event": "dialog:done", "arg": "sps_guard" },
            "alreadyDoneIf": [ "milestone:dialog:sps_guard:done" ],
            "onStart": { "reveal": "nearest_sps_guard" }, "escalate": { "markerAfter": 5 },
            "explain": { "startKey": "story.vega.m.sleeper.4.start", "chipKey": "story.vega.m.sleeper.4.obj",
                         "hintKey": "story.vega.m.sleeper.4.hint", "doneKey": "story.vega.m.sleeper.4.done" } } ] } ] },
    { "id": "sleeps",       "titleKey": "story.vega.ch.sleeps",       "fromBeat": 11, "openCutscene": "ch6.open",
      "leads": [ { "type": "research:jump_generator" }, { "type": "module:jump_generator" } ],
      "missions": [
        { "id": "m_jump", "titleKey": "story.vega.m.jump.title", "steps": [
          { "id": "m_jump.1", "tier": "core", "objective": { "type": "Lead", "target": "research:jump_generator" },
            "explain": { "startKey": "story.vega.m.jump.1.start", "chipKey": "story.vega.m.jump.1.obj",
                         "hintKey": "story.vega.m.hint.research" } },
          { "id": "m_jump.2", "tier": "core", "objective": { "type": "Lead", "target": "module:jump_generator" },
            "explain": { "startKey": "story.vega.m.jump.2.start", "chipKey": "story.vega.m.jump.2.obj",
                         "hintKey": "story.vega.m.hint.module", "doneKey": "story.vega.m.jump.2.done" } } ] },
        // #3899: ECHO's call (canon C22) — after the jump generator: fly out, beat the escort cruiser that carries VEGA's
        // sister core, board its wreck, free ECHO at the bridge console (a hacking chip). Kept; skipped silently where the
        // rules allow no space boss. The briefing has two forms: the three pieces of her call read at the towers fit
        // together, or VEGA picks the call up herself (a save without towers, or pieces still missing). The cruiser is
        // brought by the story glue (GameServerEchoCallStory.cs) while the fight step runs — a flight a pilot flees from
        // or loses simply ends, and a later flight brings it again. In multiplayer every pilot of the fight gets the
        // defeat; a player whose steps run while the wreck already drifts, or ECHO is already free, is passed on by the same
        // glue, and one who gets the mission after ECHO was freed has it done at once (alreadyDoneIf). The mission's last
        // word is the insight mission:m_echo_call — for the pilot who freed her and for the one who came too late.
        { "id": "m_echo_call", "titleKey": "story.vega.m.echo_call.title", "keep": true,
          "feasibleIf": [ "world:space_bosses" ], "steps": [
          { "id": "m_echo_call.1", "tier": "core", "objective": { "event": "space:enter" },
            "alreadyDoneIf": [ "world:echo_freed" ],
            "variants": [ { "when": "all:[lore:tower_echo_1,lore:tower_echo_2,lore:tower_echo_3]",
                            "startKey": "story.vega.m.echo_call.1.start_pieces" } ],
            "explain": { "startKey": "story.vega.m.echo_call.1.start", "chipKey": "story.vega.m.echo_call.1.obj",
                         "hintKey": "story.vega.m.echo_call.1.hint" } },
          { "id": "m_echo_call.2", "tier": "core", "objective": { "event": "cruiser:defeated" },
            "alreadyDoneIf": [ "world:echo_freed" ],
            "explain": { "startKey": "story.vega.m.echo_call.2.start", "chipKey": "story.vega.m.echo_call.2.obj",
                         "hintKey": "story.vega.m.echo_call.2.hint" } },
          { "id": "m_echo_call.3", "tier": "core", "objective": { "event": "cruiser:boarded", "arg": "echo" },
            "alreadyDoneIf": [ "world:echo_freed" ],
            "explain": { "startKey": "story.vega.m.echo_call.3.start", "chipKey": "story.vega.m.echo_call.3.obj",
                         "hintKey": "story.vega.m.echo_call.3.hint" } },
          { "id": "m_echo_call.4", "tier": "core", "objective": { "event": "echo:freed" },
            "alreadyDoneIf": [ "world:echo_freed" ],
            "explain": { "startKey": "story.vega.m.echo_call.4.start", "chipKey": "story.vega.m.echo_call.4.obj",
                         "hintKey": "story.vega.m.echo_call.4.hint" } } ] } ] },
    { "id": "core",         "titleKey": "story.vega.ch.core",         "fromBeat": 12, "openCutscene": "ch7.open",
      "leads": [ { "type": "finale" } ] },
    { "id": "resolution",   "titleKey": "story.vega.ch.resolution",   "fromEvent": "guardian_defeated",
      "leads": [ { "type": "relay" } ],
      "missions": [
        { "id": "m_survey", "titleKey": "story.vega.m.survey.title", "steps": [
          { "id": "m_survey.1", "tier": "core", "objective": { "type": "Mission", "target": "relay_survey_1" },
            "feasibleIf": [ "world:space_stations" ], "alternative": "m_survey.1a",
            "explain": { "startKey": "story.vega.m.survey.1.start", "chipKey": "story.vega.m.survey.1.obj",
