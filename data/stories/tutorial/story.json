{
  // The basic training (#2469, synthesis §3.3): six short parts B1–B6, presented by VEGA in neutral words, run per player
  // by the player-pack runtime (GameServerStoryPacks.cs). Every step is: explain → try it → the server verifies it.
  // Reference for authors: docs/developer/TUTORIAL_PACK.md. Step ids carry their chapter (b3.2); texts live in
  // locales/en.json + de.json (story.tutorial.*). The legacyKey of a step is the old onboarding stage it double-writes for
  // older builds (and the evidence the one-time migration reads). The cards (#2473, cutscenes.json): every part opens with a
  // card (b1 the welcome, b2–b6 the part card tut.strip, which carries "Part n of 6") and closes with a banner (tut.done);
  // the first launch (b6.1) and the first landing on a new world (b6.7) get a short scene, the graduation its own card.
  // The deep dives (#2479, synthesis §3.4) follow the basic training as optional chapters c2–c5: offered at the moment of
  // need (a data cache in reach, C3 done) or suggested at the graduation, started from the Journal, each opening with the
  // "Short course" card (tut.course) and closing with the part banner; docking (c4.1) and the first hyperjump (c5.8) get
  // their own card. Every do step of a deep dive counts; world rules skip a step or put its stand-in in. #2480 added the
  // parts "Ship building" and "Base building": c1 (the titanium route), c6 (modules, repair, an own ship), c7 (a base) and
  // c17 (a station) — the base founding and the commissioning of an own ship get a short scene.
  "id": "tutorial",
  "kind": "tutorial",
  "scope": "player",
  "priority": 100,
  "nameKey": "story.tutorial.name",
  "shortNameKey": "story.tutorial.short",
  "descriptionKey": "story.tutorial.desc",
  "narrator": { "id": "vega" },
  "gates": {
    "opportunityTips": "all:[step:tutorial:b2.2,step:tutorial:b3.1,step:tutorial:b4.1]",
    "banter": "pack:tutorial:done",
    "stationNear": "not:step:tutorial:b6.4"
  },
  "escalate": { "hintAfter": 180, "markerAfter": 360, "offerSkipAfter": 600 },
  "graduation": {
    "lineKey": "story.tutorial.graduated",
    "counter": "tutorial:graduated",
    // #2479: the two flight courses; #2480: the workshop course (the titanium route) third. C2, C5, C6, C7 and C17 come
    // with their own moments (a data cache in reach, the pilot course done, a module affordable, a base core, …).
    "suggest": [ "c3", "c4", "c1" ],
    "cutscene": "tut.graduation"
  },
  "chapters": [
