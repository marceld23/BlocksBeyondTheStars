        { "id": "s6.2a", "objective": { "event": "melody:solved", "arg": "song_of_return" },
          "onComplete": { "cutscene": "snd.song_of_return" },
          "explain": { "startKey": "story.sounders.s6.play.start_ring", "chipKey": "story.sounders.s6.play.chip",
                       "hintKey": "story.sounders.s6.play.hint", "doneKey": "story.sounders.s6.play.done" } }
