    {
      // Chapter 8 — the Bridge Song: persuade Roll (a dialog whose strong answers come from the Echoes), play the counter-voice
      // at the Choir Tower's eight pipes, then the sing duel with the Soundi that followed the player through Mirun.
      "id": "s8", "titleKey": "story.sounders.ch.s8", "summaryKey": "story.sounders.ch.s8.sum", "openCutscene": "snd.part",
      "closeCutscene": "snd.epilogue",
      "steps": [
        { "id": "s8.1", "objective": { "event": "dialog:done", "arg": "snd_roll" },
          "onStart": { "reveal": "pack_site:choir_tower" },
          "explain": { "startKey": "story.sounders.s8.roll.start", "chipKey": "story.sounders.s8.roll.chip",
                       "hintKey": "story.sounders.s8.roll.hint", "doneKey": "story.sounders.s8.roll.done" } },
        { "id": "s8.2", "objective": { "event": "melody:solved", "arg": "bridge_song" },
          "onComplete": { "cutscene": "snd.bridge_song" },
          "explain": { "startKey": "story.sounders.s8.bridge.start", "chipKey": "story.sounders.s8.bridge.chip",
                       "hintKey": "story.sounders.s8.bridge.hint", "doneKey": "story.sounders.s8.bridge.done" } },
        { "id": "s8.3", "kind": "read", "explain": { "startKey": "story.sounders.s8.listen.start" } },
        { "id": "s8.4", "objective": { "event": "melody:solved", "arg": "sing_duel" },
          "onComplete": { "cutscene": "snd.soundi_joins" },
