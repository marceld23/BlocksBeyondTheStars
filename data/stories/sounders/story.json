                       "hintKey": "story.sounders.s5.elora.hint", "doneKey": "story.sounders.s5.elora.done" } },
        { "id": "s5.1a", "objective": { "event": "echo:questioned", "arg": "elora" },
          "explain": { "startKey": "story.sounders.s5.elora.start_away", "chipKey": "story.sounders.s5.elora.chip_away",
