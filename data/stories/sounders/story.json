  // The dialogs: the four Echoes (questions are sung — "melody" — and each Echo's last answer writes its milestone; the
  // story code turns the end of an Echo dialog into echo:questioned), the Eldest in Mirun and Roll at the Choir Tower.
  // Roll's weak answers keep the dialog open, so the player simply tries another; the good answers carry what the Echoes
  // told. All are bound to code-spawned NPCs by "character" (GameServerSoundersStory places them).
  "dialogs": [
    { "key": "snd_echo_elora", "character": "elora", "minStage": "", "oncePerPlayer": true, "nodes": [
      { "promptKey": "story.sounders.dlg.elora.n0", "choices": [ { "textKey": "story.sounders.q.who", "melody": "MIRA", "responseKey": "story.sounders.dlg.elora.n0.r", "next": 1 } ] },
      { "promptKey": "story.sounders.dlg.elora.n1", "choices": [ { "textKey": "story.sounders.q.what", "melody": "KEI", "responseKey": "story.sounders.dlg.elora.n1.r", "next": 2 } ] },
      { "promptKey": "story.sounders.dlg.elora.n2", "choices": [ { "textKey": "story.sounders.q.letters", "melody": "NIRI", "responseKey": "story.sounders.dlg.elora.n2.r", "consequence": "milestone:snd:echo:elora" } ] }
