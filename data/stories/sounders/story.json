      ]
    },
    {
      // Chapter 5 — the Echoes: Elora at the shrine (or any rune stones), then Kamo and Feya, then Tini on another world.
      "id": "s5", "titleKey": "story.sounders.ch.s5", "summaryKey": "story.sounders.ch.s5.sum", "openCutscene": "snd.part",
