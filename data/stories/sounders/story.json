        { "id": "s4.5", "objective": { "event": "disc:decoded", "arg": "song_disc_great_song" },
          "explain": { "startKey": "story.sounders.s4.great.start", "chipKey": "story.sounders.s4.great.chip",
                       "hintKey": "story.sounders.s4.great.hint", "doneKey": "story.sounders.s4.great.done" } },
        { "id": "s4.6", "objective": { "event": "craft:any", "arg": "obsidian_chest" },
          "explain": { "startKey": "story.sounders.s4.armour.start", "chipKey": "story.sounders.s4.armour.chip",
                       "hintKey": "story.sounders.s4.armour.hint" } },
        { "id": "s4.7", "objective": { "event": "disc:inserted", "arg": "song_disc_hearing" },
          "explain": { "startKey": "story.sounders.s4.socket.start", "chipKey": "story.sounders.s4.socket.chip",
                       "hintKey": "story.sounders.s4.socket.hint", "doneKey": "story.sounders.s4.socket.done" } }
      ]
    },
    {
      // Chapter 5 — the Echoes: Elora at the shrine (or any rune stones), then Kamo and Feya, then Tini on another world.
      "id": "s5", "titleKey": "story.sounders.ch.s5", "summaryKey": "story.sounders.ch.s5.sum", "openCutscene": "snd.part",
      "steps": [
        { "id": "s5.1", "objective": { "event": "echo:questioned", "arg": "elora" },
          "onStart": { "reveal": "unique_site:shrine" }, "feasibleIf": [ "world:shrine_reachable" ], "alternative": "s5.1a",
          "explain": { "startKey": "story.sounders.s5.elora.start", "chipKey": "story.sounders.s5.elora.chip",
