                       "doneKey": "story.sounders.s4.blaster.done" } },
        { "id": "s4.4", "objective": { "event": "chamber:opened" },
          "onStart": { "reveal": "nearest_monument" }, "onComplete": { "cutscene": "snd.chamber" },
          "explain": { "startKey": "story.sounders.s4.chamber.start", "chipKey": "story.sounders.s4.chamber.chip",
                       "hintKey": "story.sounders.s4.chamber.hint", "doneKey": "story.sounders.s4.chamber.done" } },
        { "id": "s4.5", "objective": { "event": "disc:decoded", "arg": "song_disc_great_song" },
          "explain": { "startKey": "story.sounders.s4.great.start", "chipKey": "story.sounders.s4.great.chip",
                       "doneKey": "story.sounders.s4.great.done" } },
        { "id": "s4.6", "objective": { "event": "craft:any", "arg": "obsidian_chest" },
          "explain": { "startKey": "story.sounders.s4.armour.start", "chipKey": "story.sounders.s4.armour.chip",
                       "hintKey": "story.sounders.s4.armour.hint" } },
        { "id": "s4.7", "objective": { "event": "disc:inserted", "arg": "song_disc_hearing" },
