          "onComplete": { "cutscene": "snd.landing" },
          "explain": { "startKey": "story.sounders.s7.land.start", "chipKey": "story.sounders.s7.land.chip" } },
        { "id": "s7.3", "objective": { "event": "dialog:done", "arg": "snd_eldest" },
