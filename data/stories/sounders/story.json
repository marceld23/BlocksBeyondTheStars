        { "id": "s5.1a", "objective": { "event": "echo:questioned", "arg": "elora" }, "onStart": { "reveal": "nearest_rune_shrine" },
          "explain": { "startKey": "story.sounders.s5.elora.start_away", "chipKey": "story.sounders.s5.elora.chip_away",
                       "hintKey": "story.sounders.s5.elora.hint", "doneKey": "story.sounders.s5.elora.done" } },
        { "id": "s5.2", "objective": { "event": "echo:questioned", "arg": "kamo|feya", "required": 2 },
          "onComplete": { "cutscene": "snd.great_song" },
          "explain": { "startKey": "story.sounders.s5.more.start", "chipKey": "story.sounders.s5.more.chip",
                       "hintKey": "story.sounders.s5.more.hint" } },
        { "id": "s5.3", "objective": { "event": "echo:questioned", "arg": "tini" },
          "explain": { "startKey": "story.sounders.s5.tini.start", "chipKey": "story.sounders.s5.tini.chip",
