{
  // "The Sounders' Song" (Das Lied der Sounders), epic #3368 — the second story next to VEGA, a side pack per player.
  // The music notes on the rune stones (monuments, the Singing Shrine, lone stones, ruins) are the Sounders' script: the
  // player plays them, answers the Singing Shrine, decodes Song Discs with the note alphabet, builds the Sounders' alien
  // blueprints, questions the Echoes (the vanished Sounders, on "the other side"), plays the Song of Return (ORNEMIS) to
  // find the detuned home system, lands on Soaniri and sings the Bridge Song with the Young Voices — then wins a Soundi.
  // Lore, creature designs and names: the maintainer, Justus and the school club "Building Games with AI" (2026-11-07).
  // VEGA narrates; the Echoes, the Eldest and Roll speak in the scenes (speakers). Docs: docs/developer/STORY_SOUNDERS.md.
  //
  // Start: once the player played a rune stone (milestone snd:first_rune, written by every rune use), and not before part 1
  // of the basic training; "earlyOptIn" lets a player start it from the Journal (chapter 1 then shows the way to a monument).
  "id": "sounders",
  "nameKey": "story.sounders.name",
  "shortNameKey": "story.sounders.short",
  "descriptionKey": "story.sounders.desc",
  "kind": "side",
  "scope": "player",
  "priority": 20,
  "narrator": {
    "id": "vega", "nameKey": "ui.vega.name", "icon": "icon_vega", "color": "#5FD8FF",
    "voice": [ "vega_chatter_1", "vega_chatter_2", "vega_chatter_3" ], "lineStart": "ai_blip"
  },
  "speakers": [
    { "id": "elora",  "nameKey": "story.sounders.spk.elora",  "color": "#6FE3C1", "lineStart": "echo_hum_1" },
    { "id": "kamo",   "nameKey": "story.sounders.spk.kamo",   "color": "#7FD8E8", "lineStart": "echo_hum_2" },
    { "id": "feya",   "nameKey": "story.sounders.spk.feya",   "color": "#9BE8B0", "lineStart": "echo_hum_3" },
    { "id": "tini",   "nameKey": "story.sounders.spk.tini",   "color": "#B6C8FF", "lineStart": "echo_hum_4" },
    { "id": "eldest", "nameKey": "story.sounders.spk.eldest", "color": "#E8C27A", "lineStart": "elder_hum_1" },
    { "id": "roll",   "nameKey": "story.sounders.spk.roll",   "color": "#F2A65A", "lineStart": "elder_hum_2" }
  ],
  "start": { "after": [ "any:[chapter:tutorial:b1, not:pack:tutorial:enabled]", "milestone:snd:first_rune" ], "earlyOptIn": true },
  "introCutscene": "snd.stones_sing",
  // The pack's own per-player milestones (dialog consequences may set snd:… only), the Song Archive (texts below) and
  // Ornemis: appended to the galaxy the first time a player learns the Song of Return, shown only to players who did.
  "milestonePrefix": "snd",
  "textsTitleKey": "story.sounders.archive",
  "systems": [
    { "id": "ornemis", "nameKey": "story.sounders.system.ornemis", "planetType": "sounder_world", "bodyName": "Soaniri",
      "placement": "inside", "visibleIf": "milestone:snd:song_learned" }
  ],
  "chapters": [
    {
      // Chapter 1 — the stones sing: play runes, every word lands in the Song Archive.
      "id": "s1", "titleKey": "story.sounders.ch.s1", "summaryKey": "story.sounders.ch.s1.sum", "openCutscene": "snd.part",
      "steps": [
        { "id": "s1.1", "kind": "read", "explain": { "startKey": "story.sounders.s1.notes.start" } },
        { "id": "s1.2", "objective": { "event": "rune:played", "required": 3 },
          "onStart": { "reveal": "nearest_monument" }, "feasibleIf": [ "world:monuments" ], "alternative": "s1.2a",
          "explain": { "startKey": "story.sounders.s1.play.start", "chipKey": "story.sounders.s1.play.chip",
                       "hintKey": "story.sounders.s1.play.hint", "doneKey": "story.sounders.s1.play.done" } },
        { "id": "s1.2a", "objective": { "event": "rune:played", "required": 3 },
          "explain": { "startKey": "story.sounders.s1.play.start", "chipKey": "story.sounders.s1.play.chip",
                       "hintKey": "story.sounders.s1.play.hint_away", "doneKey": "story.sounders.s1.play.done" } },
        { "id": "s1.3", "kind": "read", "explain": { "startKey": "story.sounders.s1.together.start" } }
      ]
    },
    {
      // Chapter 2 — the Singing Shrine's eight pillars are the eight tones; the repeat puzzle gives the Song Spindle and
      // disc 1. Old saves without a shrine: a ring of eight rune stones around an ancient brick works the same way.
      "id": "s2", "titleKey": "story.sounders.ch.s2", "summaryKey": "story.sounders.ch.s2.sum", "openCutscene": "snd.part",
      "steps": [
        { "id": "s2.1", "objective": { "event": "melody:solved", "arg": "shrine_echo" },
          "onStart": { "reveal": "unique_site:shrine" }, "feasibleIf": [ "world:shrine" ], "alternative": "s2.1a",
          "onComplete": { "cutscene": "snd.shrine_answers" },
          "explain": { "startKey": "story.sounders.s2.shrine.start", "chipKey": "story.sounders.s2.shrine.chip",
                       "hintKey": "story.sounders.s2.shrine.hint", "doneKey": "story.sounders.s2.shrine.done" } },
        { "id": "s2.1a", "objective": { "event": "melody:solved", "arg": "shrine_echo" },
          "onComplete": { "cutscene": "snd.shrine_answers" },
          "explain": { "startKey": "story.sounders.s2.ring.start", "chipKey": "story.sounders.s2.ring.chip",
                       "hintKey": "story.sounders.s2.ring.hint", "doneKey": "story.sounders.s2.ring.done" } }
      ]
    },
    {
      // Chapter 3 — Song Discs: place the spindle, decode disc 1 (the note-key minigame), find and decode two more.
      "id": "s3", "titleKey": "story.sounders.ch.s3", "summaryKey": "story.sounders.ch.s3.sum", "openCutscene": "snd.part",
      "steps": [
        { "id": "s3.1", "objective": { "event": "build:any", "arg": "song_spindle" },
          "explain": { "startKey": "story.sounders.s3.place.start", "chipKey": "story.sounders.s3.place.chip" } },
        { "id": "s3.2", "objective": { "event": "disc:decoded", "arg": "song_disc_beginning" },
          "onComplete": { "cutscene": "snd.decoded" },
          "explain": { "startKey": "story.sounders.s3.decode.start", "chipKey": "story.sounders.s3.decode.chip",
                       "hintKey": "story.sounders.s3.decode.hint", "doneKey": "story.sounders.s3.decode.done" } },
        { "id": "s3.3", "kind": "read", "explain": { "startKey": "story.sounders.s3.sorry.start" } },
        { "id": "s3.4", "objective": { "event": "disc:decoded", "arg": "song_disc_builders|song_disc_hearing", "required": 2 },
          "onStart": { "reveal": "nearest_monument" },
          "explain": { "startKey": "story.sounders.s3.more.start", "chipKey": "story.sounders.s3.more.chip",
                       "hintKey": "story.sounders.s3.more.hint", "doneKey": "story.sounders.s3.more.done" } }
      ]
    },
    {
