<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Lets the test suite reach pure helpers that would otherwise need a full server spin-up to exercise
         (e.g. the far-column streaming band). Same arrangement WorldGeneration already uses. -->
    <InternalsVisibleTo Include="BlocksBeyondTheStars.Tests" />
    <ProjectReference Include="..\BlocksBeyondTheStars.Shared\BlocksBeyondTheStars.Shared.csproj" />
    <ProjectReference Include="..\BlocksBeyondTheStars.WorldGeneration\BlocksBeyondTheStars.WorldGeneration.csproj" />
    <ProjectReference Include="..\BlocksBeyondTheStars.Persistence\BlocksBeyondTheStars.Persistence.csproj" />
    <ProjectReference Include="..\BlocksBeyondTheStars.Networking\BlocksBeyondTheStars.Networking.csproj" />
  </ItemGroup>

  <!-- Two flavors of the same sources: the net10.0 EXE is the dedicated/bundled server host; the
       netstandard2.1 LIBRARY is the authoritative simulation consumed by the Unity client for the
       in-browser (WebGL) singleplayer — same code, driven by an external Tick() pump over the
       LoopbackTransport instead of Run()+sockets. The console host shell stays net10-only. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="Program.cs" />
  </ItemGroup>

</Project>
